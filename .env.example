# Copy to .env (git ignores it) or set these in your environment. Never commit real values.
# Shared admin key (optional). Prefer named keys: voiceshop keys create --name <person> --role <role>
VOICESHOP_API_KEY=
# Where the named keys (hashes only) are kept. Leave unset for the container: compose sets /data paths.
# VOICESHOP_KEYS_FILE=results/api_keys.json
# Local monitor only: allow changes without a key. Refused on any non-loopback address.
VOICESHOP_LOCAL_UI_NO_KEY=
# Database. Leave unset for the container: compose sets /data paths.
# VOICESHOP_DB=results/voiceshop.db
# Limits
VOICESHOP_MAX_CONCURRENT_RUNS=2
VOICESHOP_MAX_BODY_BYTES=65536
VOICESHOP_LOG_LEVEL=INFO
# Run transcripts older than this many days are removed (the audit trail is kept)
VOICESHOP_RETENTION_DAYS=14
# Gemini (speech check and judge only; not used by the rules router)
GEMINI_API_KEY=
VOICESHOP_GEMINI_MODEL=gemini-3.5-flash
